{
  "expo": {
    "name": "Populus",
    "slug": "populus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.teampick.bfsfcz",
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSCameraUsageDescription": "Scatta foto per il tuo profilo",
        "NSPhotoLibraryUsageDescription": "Carica foto per il tuo profilo",
        "NSUserTrackingUsageDescription": "Ti mostriamo pubblicità più pertinenti ai tuoi interessi.",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories",
          "fb-messenger",
          "fb",
          "whatsapp",
          "tg",
          "twitter"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "backgroundColor": "#000000",
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.teampick.bfsfcz",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "backgroundColor": "#000000",
          "buttonStyle": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-video",
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5117475525408614~4457423204",
          "iosAppId": "ca-app-pub-5117475525408614~8450574308",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Ti mostriamo pubblicità più pertinenti ai tuoi interessi."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "useFrameworks": "static" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
